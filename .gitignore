# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.js.map
*.d.ts
*.d.ts.map

# Local ad-hoc scripts / scratch work (not part of the Traefik or gateway stacks)
scratch/

# Per-checkout state for the bug-finding automation, not repo content
MEMORIES.md

# Traefik ACME store (path next to docker/traefik/docker-compose.yml)
docker/traefik/letsencrypt/

# Environment & secrets
.env
.env.*
!.env.example

# TypeScript cache
*.tsbuildinfo

# Editor
.vscode/
.idea/
.cursor/mcp.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local gauntlet / matrix run artifacts
packages/cli/reports/

# Perf results are generated artifacts; keep local by default.
perf/results/**
!perf/results/.gitkeep

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/

# Ad-hoc SQL kept locally (not the supported public→api path; use `flux push -s`)
packages/cli/migrations/move_to_api.sql

# Local database snapshots (initial baseline may be tracked intentionally)
database-backups/
.snapshots/
